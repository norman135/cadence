# Copy this file to .env and fill it in. Never commit .env.

# Public domain name. Caddy obtains an HTTPS certificate for it automatically.
# Point the domain's DNS A/AAAA record at this server before starting the stack.
# Use "localhost" to try the stack on your own machine (self-signed certificate).
CADENCE_DOMAIN=cadence.example.com

# Release to run, e.g. 0.1.0. "latest" follows the newest stable release.
CADENCE_VERSION=latest

# Database password. Use a long random value, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=change-me
