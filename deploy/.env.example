# Copy this file to .env and fill it in. Never commit .env.

# Public domain name. Caddy obtains an HTTPS certificate for it automatically.
# Point the domain's DNS A/AAAA record at this server before starting the stack.
# Use "localhost" to try the stack on your own machine (self-signed certificate).
CADENCE_DOMAIN=cadence.example.com

# Release to run, e.g. 0.2.0. "latest" follows the newest stable release.
CADENCE_VERSION=latest

# Database password. Use a long random value, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=change-me

# Secret that signs access tokens (at least 32 characters), e.g. `openssl rand -base64 48`.
# Changing it signs everyone out within 10 minutes; sessions then refresh transparently.
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-of-at-least-32-characters

# Accounts. Set ALLOW_REGISTRATION=false for an invitation-only instance.
# Email confirmation needs working SMTP below; set REQUIRE_CONFIRMED_EMAIL=false if you have none.
ALLOW_REGISTRATION=true
REQUIRE_CONFIRMED_EMAIL=true

# Outgoing email (confirmation, password reset, invitations). Without SMTP_HOST, emails are dropped.
EMAIL_FROM_ADDRESS=cadence@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
