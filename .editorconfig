root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,md,ts,tsx,js,mjs,cjs,css,html,props,targets,csproj,slnx,xml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- Language style -----------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_readonly_field = true:warning

# --- Naming ------------------------------------------------------------
# Rules are matched in order: constants, then static fields, then instance fields.
dotnet_naming_rule.constants_pascal.symbols = constant_fields
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.private_static_fields_s_prefix.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_s_prefix.style = s_camel
dotnet_naming_rule.private_static_fields_s_prefix.severity = warning
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_style.s_camel.capitalization = camel_case
dotnet_naming_style.s_camel.required_prefix = s_

dotnet_naming_rule.private_fields_camel_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_camel_underscore.style = camel_underscore
dotnet_naming_rule.private_fields_camel_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_underscore.capitalization = camel_case
dotnet_naming_style.camel_underscore.required_prefix = _

# --- Enforced at build time (EnforceCodeStyleInBuild) --------------------
dotnet_diagnostic.IDE0005.severity = warning   # unused usings
dotnet_diagnostic.IDE0161.severity = warning   # file-scoped namespaces
dotnet_diagnostic.IDE0011.severity = warning   # braces
dotnet_diagnostic.IDE0044.severity = warning   # readonly fields

# --- Analyzer tuning ------------------------------------------------------
# ASP.NET Core has no SynchronizationContext; ConfigureAwait(false) adds noise without benefit.
dotnet_diagnostic.CA2007.severity = none
# Public API types in an application (not a library) don't need to be sealed or internal by default.
dotnet_diagnostic.CA1515.severity = none
# Keyword clashes only matter for Visual Basic consumers; this is a C#-only application.
dotnet_diagnostic.CA1716.severity = none

# Generated code (EF Core migrations) is excluded from style and analyzer rules.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Tests: descriptive underscore names are idiomatic, and xUnit fixtures are instantiated by the framework.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none   # xUnit collection definitions are conventionally named "*Collection"
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA2234.severity = none

# Benchmarks: BenchmarkDotNet requires instance methods on public, non-sealed classes.
[tests/Cadence.Benchmarks/**.cs]
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1852.severity = none
