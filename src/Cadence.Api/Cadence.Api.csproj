<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      The OpenAPI document is generated at build time and committed to /openapi. The frontend's typed
      client is generated from it, and CI fails if either is out of date. Container builds turn this
      off with -p:OpenApiGenerateDocuments=false.
    -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name cadence</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cadence.Application\Cadence.Application.csproj" />
    <ProjectReference Include="..\Cadence.Infrastructure\Cadence.Infrastructure.csproj" />
    <ProjectReference Include="..\Cadence.ServiceDefaults\Cadence.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cadence.Api.IntegrationTests" />
    <InternalsVisibleTo Include="Cadence.Benchmarks" />
  </ItemGroup>

</Project>
